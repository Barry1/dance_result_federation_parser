include Makefile.competitions.2026 Makefile.competitions.2025 Makefile.competitions.2024 Makefile.competitions.2023 Makefile.competitions.2022

URL_GLM4_MASIV_STD_2023.txt = https://tanzen-in-sh.de/ergebnisse/2023/2023-03-12_GLM4_MASIV_D-S_STD/index.htm
#URL_BlauesBand2018.txt = https://www.blauesband-berlin.de/Ergebnisse/2018/blauesband2018/index.htm
#URL_BlauesBand2019.txt = https://www.blauesband-berlin.de/Ergebnisse/2019/blauesband2019/index.htm

HolmOstern2022.txt:
	$(runme) http://www.die-ostsee-tanzt.de/turnierergebnisse/ostsee-ostern-2022/freitag/index.htm > $@ 2> $(@:.txt=.err)
	$(runme) http://www.die-ostsee-tanzt.de/turnierergebnisse/ostsee-ostern-2022/samstag/index.htm >> $@ 2>> $(@:.txt=.err)
	$(runme) http://www.die-ostsee-tanzt.de/turnierergebnisse/ostsee-ostern-2022/sonntag/index.htm >> $@ 2>> $(@:.txt=.err)
	$(runme) http://www.die-ostsee-tanzt.de/turnierergebnisse/ostsee-ostern-2022/montag/index.htm >> $@ 2>> $(@:.txt=.err)

%_GOC.txt:
	$(rungoc)

Results/%_GOC.txt:
	poetry run python3 goc_parser.py $* > $@ 2> $(@:.txt=.err)
